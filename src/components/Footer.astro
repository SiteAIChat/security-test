---
interface Props {
  items?: { label: string; href: string }[];
}

const { items = [] } = Astro.props;

const defaultLinks = items.length > 0 ? items : [
  { label: "Home", href: "#" },
  { label: "Documentation", href: "#documentation" },
  { label: "Learn More", href: "#learn-more" },
];

const currentYear = new Date().getFullYear();
---

<footer class="relative border-t border-gray-100 bg-gradient-to-b from-white to-gray-50">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <div class="flex flex-col md:flex-row items-center justify-between gap-8">
      <div class="flex items-center gap-2">
        <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-primary to-secondary flex items-center justify-center">
          <span class="text-white font-bold text-sm">E</span>
        </div>
        <span class="text-lg font-bold text-foreground">Example Domain</span>
      </div>

      <nav aria-label="Footer navigation">
        <ul class="flex flex-wrap items-center justify-center gap-6" role="list">
          {defaultLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm text-gray-500 hover:text-primary transition-colors duration-200"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <div class="mt-8 pt-8 border-t border-gray-100 text-center">
      <p class="text-sm text-gray-400">
        &copy; {currentYear} Example Domain. This domain is for use in documentation examples.
      </p>
    </div>
  </div>
</footer>
