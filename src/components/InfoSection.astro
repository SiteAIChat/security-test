---
interface Props {
  items?: { title: string; description: string }[];
}

const { items = [] } = Astro.props;
---

<section id="documentation" class="py-20 sm:py-28 bg-gradient-to-b from-gray-50/50 to-white">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl mx-auto text-center mb-16">
      <span class="text-sm font-semibold text-secondary uppercase tracking-wider">About this domain</span>
      <h2 class="mt-3 text-3xl sm:text-4xl font-bold text-foreground">
        Built for Documentation
      </h2>
      <p class="mt-4 text-lg text-gray-500">
        This domain is for use in documentation examples without needing permission.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
      <div class="group relative p-8 rounded-2xl bg-white border border-gray-100 shadow-sm hover:shadow-lg hover:border-primary/20 transition-all duration-500">
        <div class="absolute inset-0 rounded-2xl bg-gradient-to-br from-primary/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
        <div class="relative">
          <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-primary to-primary/80 flex items-center justify-center mb-5 shadow-lg shadow-primary/20">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-foreground mb-2">Documentation Examples</h3>
          <p class="text-gray-500 leading-relaxed">
            Use this domain freely in illustrative examples within documentation, tutorials, and technical writing.
          </p>
        </div>
      </div>

      <div class="group relative p-8 rounded-2xl bg-white border border-gray-100 shadow-sm hover:shadow-lg hover:border-secondary/20 transition-all duration-500">
        <div class="absolute inset-0 rounded-2xl bg-gradient-to-br from-secondary/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
        <div class="relative">
          <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-secondary to-secondary/80 flex items-center justify-center mb-5 shadow-lg shadow-secondary/20">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-foreground mb-2">No Permission Needed</h3>
          <p class="text-gray-500 leading-relaxed">
            This domain is reserved specifically so you can use it without needing any authorization or coordination.
          </p>
        </div>
      </div>

      <div class="group relative p-8 rounded-2xl bg-white border border-gray-100 shadow-sm hover:shadow-lg hover:border-primary/20 transition-all duration-500">
        <div class="absolute inset-0 rounded-2xl bg-gradient-to-br from-primary/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
        <div class="relative">
          <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-primary/80 to-secondary/80 flex items-center justify-center mb-5 shadow-lg shadow-primary/20">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-foreground mb-2">Avoid Operational Use</h3>
          <p class="text-gray-500 leading-relaxed">
            This domain is strictly for illustrative purposes. Avoid use in production operations or live systems.
          </p>
        </div>
      </div>

      <div class="group relative p-8 rounded-2xl bg-white border border-gray-100 shadow-sm hover:shadow-lg hover:border-secondary/20 transition-all duration-500">
        <div class="absolute inset-0 rounded-2xl bg-gradient-to-br from-secondary/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
        <div class="relative">
          <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-secondary/80 to-primary/80 flex items-center justify-center mb-5 shadow-lg shadow-secondary/20">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-foreground mb-2">Learn More</h3>
          <p class="text-gray-500 leading-relaxed">
            Discover more about reserved domains and how they serve the internet documentation ecosystem.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
